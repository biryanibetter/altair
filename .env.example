# Copy placeholders to .env.local at repo root for Drizzle CLI.
# Copy the same Supabase variables plus DATABASE_URL to apps/web/.env.local for Next.js.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
SUPABASE_SECRET_KEY=YOUR-SERVER-ONLY-SECRET-KEY
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# Task 002: server-only ingestion. Generate a random secret with >=32 characters.
# Never use NEXT_PUBLIC_ prefixes. Copy secret into Supabase Vault after deployment.
INGESTION_SECRET=
INGESTION_LATITUDE=25.3
INGESTION_LONGITUDE=51.5
INGESTION_MARINE_LONGITUDE=52
QATAR_TRADE_YEAR=2024
QATAR_HS_PREFIX=10
COMTRADE_MODE=preview
COMTRADE_PERIOD=2024
COMTRADE_REPORTER=634
COMTRADE_HS_CODE=10
# Required only for COMTRADE_MODE=subscription. Never sent in a query string.
COMTRADE_API_KEY=
GDELT_QUERY=Qatar (shipping OR port OR trade)
# Task 003: optional server-only routing geometry enrichment. Keep disabled until
# provider access, usage costs and license/attribution terms have been approved.
ROUTING_ENRICHMENT_ENABLED=false
HERE_API_KEY=
SEAROUTES_API_KEY=
# Task 007: server-only free inference; blank key safely disables assistant inference.
ALTAIR_LLM_PROVIDER=openrouter
ALTAIR_LLM_BASE_URL=https://openrouter.ai/api/v1
ALTAIR_LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=
# No NEXT_PUBLIC_ versions. Never use a key shared in chat; rotate it first.
# Task 006: opt-in transport evidence, never proof of cargo location.
# Review provider access, licenses and quotas before enabling. lonMin,latMin,lonMax,latMax.
TRANSPORT_BBOX=50,24,52,27
OPENSKY_ENABLED=false
# Optional externally managed OAuth2 Bearer token; no legacy Basic authentication.
OPENSKY_ACCESS_TOKEN=
HERE_TRAFFIC_ENABLED=false
AISSTREAM_ENABLED=false
AISSTREAM_API_KEY=
# Only set to worker for an authorized non-Vercel Node process. AIS has no polling API.
AISSTREAM_RUNTIME=disabled
# Webcams require a reviewed manifest + authorized metadata collector in server code;
# no camera URL, CCTV scanning, or shipment-provider credentials are assumed.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DATABASE-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
