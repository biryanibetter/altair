# ALTAIR Environment Configuration
# Copy this file to .env.local and fill in your values

# Application
NEXT_PUBLIC_APP_NAME=ALTAIR
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API (for future backend integration)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database (for future Supabase/PostgreSQL integration)
# DATABASE_URL=postgresql://user:password@localhost:5432/altair
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI Providers (for future integration)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# External APIs (for future logistics data integration)
# MAPBOX_TOKEN=
# WEATHER_API_KEY=
# MARINE_TRAFFIC_API_KEY=
# AVIATION_STACK_API_KEY=

# Feature Flags
NEXT_PUBLIC_ENABLE_MOCK_DATA=true
NEXT_PUBLIC_ENABLE_CRISIS_MODE=false